{
  "name": "clocked-in",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/with-env.mjs local -- next dev --port 3025",
    "dev:staging": "node scripts/with-env.mjs staging -- next dev --port 3025",
    "push:staging": "node scripts/push-branch.mjs --branch staging",
    "push:production": "node scripts/push-branch.mjs --branch main",
    "build": "node scripts/with-env.mjs -- node scripts/build.mjs",
    "build:staging": "node scripts/with-env.mjs staging -- node scripts/build.mjs",
    "build:production": "node scripts/with-env.mjs production -- node scripts/build.mjs",
    "start": "node scripts/with-env.mjs local -- next start --port 3025",
    "start:staging": "node scripts/with-env.mjs staging -- next start --port 3025",
    "start:production": "node scripts/with-env.mjs production -- next start --port 3025",
    "env:print": "node scripts/with-env.mjs -- node scripts/print-env.mjs",
    "lint": "eslint",
    "test:http": "node --test --test-concurrency=4 tests/http/*.test.mjs",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "test:e2e:prod": "E2E_ENV=PROD playwright test -c tests/e2e/playwright.config.ts",
    "test:e2e:staging": "E2E_ENV=STAGING playwright test -c tests/e2e/playwright.config.ts",
    "test:http:next": "API_TARGET=next npm run test:http",
    "test:http:csharp": "API_TARGET=csharp npm run test:http",
    "db:pull": "prisma db pull && prisma generate",
    "db:seed:caswj": "node scripts/with-env.mjs local -- tsx scripts/seed-caswj.ts",
    "db:seed:caswj:production": "node scripts/with-env.mjs production -- tsx scripts/seed-caswj.ts",
    "test:contract": "node --test --test-concurrency=1 \"tests/http/*.test.mjs\"",
    "email:dev": "email dev --dir emails --port 3030",
    "email:render": "tsx emails/render.ts",
    "postinstall": "node scripts/with-env.mjs -- prisma generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tanstack/react-query": "^5.104.3",
    "@tanstack/react-query-devtools": "^5.104.3",
    "@vercel/blob": "^2.8.2",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "colorjs.io": "^0.7.1",
    "jose": "^6.2.12",
    "lucide-react": "^1.57.0",
    "next": "16.4.1",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.5",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@react-email/ui": "^6.11.2",
    "@tailwindcss/turbopack": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.8",
    "eslint": "^9",
    "eslint-config-next": "16.4.1",
    "exceljs": "^4.4.0",
    "prisma": "^7.10.0",
    "react-email": "^6.11.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
