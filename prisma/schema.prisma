  name           String           @db.Citext
  layout         Json             @default("{\"version\": 1, \"cards\": []}")
  baseTemplateId String?          @db.Uuid
  createdAt      DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @db.Timestamptz(6)
  baseTemplate   ReportTemplate?  @relation("ReportTemplateBase", fields: [baseTemplateId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_ReportTemplate_ReportTemplate_baseTemplateId")
  overrides      ReportTemplate[] @relation("ReportTemplateBase")
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_ReportTemplate_Organization_organizationId")

  @@unique([key], map: "ReportTemplate_global_key", where: raw("(\"organizationId\" IS NULL AND \"key\" IS NOT NULL)"))
  @@unique([name], map: "ReportTemplate_global_name", where: raw("(\"organizationId\" IS NULL)"))
  @@unique([organizationId, baseTemplateId], map: "ReportTemplate_override", where: raw("(\"baseTemplateId\" IS NOT NULL)"))
  @@unique([organizationId, name], map: "ReportTemplate_org_name", where: raw("(\"organizationId\" IS NOT NULL)"))
  @@index([baseTemplateId], map: "IX_ReportTemplate_baseTemplateId")
}

