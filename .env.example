# Copy to .env for this machine. Staging and production have their own files:
#   .env            local
#   .env.staging    staging
#   .env.production production
# Every environment uses PostgreSQL.
#
# Vercel builds Production and Preview with NODE_ENV=production, so it will not
# choose .env.staging on its own, and a committed .env.production would apply to
# both. Keep the files local and set the same keys in Vercel:
#   Production environment ← .env.production
#   Preview environment    ← .env.staging
# A custom environment named staging is also staging.

# local | staging | production
APP_ENV="local"
# postgresql. "postgres" and the "postgressql" typo are accepted.
DATABASE_PROVIDER="postgresql"
# next for the Next.js API. csharp for the .NET API contract tests.
API_TARGET="next"

# Shared Postgres. Local Docker maps this to port 5435.
# Entity Framework owns migrations. Prisma introspects this same database.
DATABASE_URL="postgresql://clocked_in:clocked_in@localhost:5435/clocked_in?schema=public"
EF_DATABASE_URL="postgresql://clocked_in:clocked_in@localhost:5435/clocked_in?schema=public"

# Shared by the Next.js API and the .NET API. Use a long local-only value here.
JWT_SIGNING_KEY="dev-only-clocked-in-jwt-signing-key-32"
JWT_ISSUER="clocked-in"
JWT_AUDIENCE="clocked-in"
# HMAC pepper for organization API keys. At least 32 characters.
API_KEY_PEPPER="dev-only-clocked-in-api-key-pepper-32"

# Optional. When set, Next.js proxies REST API routes to ClockedIn.Api (BFF).
# CSHARP_API_URL="http://127.0.0.1:5103"
# Optional CORS allow-list for the .NET API (comma-separated origins). Defaults to APP_URL.
# CORS_ORIGINS="https://clocked-in.baddley.us"
# Optional Application Insights for ClockedIn.Api.
# APPLICATIONINSIGHTS_CONNECTION_STRING=""

# Resend sends invite and password-reset codes. EMAIL_FROM must be a verified sender.
RESEND_API_KEY=""
EMAIL_FROM="VolunTime (dev) <noreply@voluntime.app>"
RESEND_API_URL="https://api.resend.com/emails"

# Public site URL included in invite and password-reset emails.
APP_URL="http://localhost:3025"

# Optional. Fine-grained PAT with Issues: Read and write on one repo (owner/name).
# GITHUB_API_URL defaults to https://api.github.com. Point it at tests/http/github-sink.mjs for HTTP tests.
GITHUB_TOKEN=""
GITHUB_REPO="owner/name"
# GITHUB_API_URL="https://api.github.com"

# Vercel Blob store for organization favicons and logos.
# BLOB_ACCESS must match the store the token belongs to: "public" or "private".
# Unset uses public on Vercel production and private elsewhere.
# The Vercel staging environment sets this to public. Local tokens use a private store.
# The SDK authenticates with BLOB_READ_WRITE_TOKEN. BLOB_STORE_ID is optional
# (needed only when authenticating with Vercel OIDC instead of the token).
BLOB_ACCESS=""
BLOB_READ_WRITE_TOKEN=""
BLOB_STORE_ID=""

# Azure CLI service principal for local `az login` (never commit the secret).
# AZURE_CLIENT_ID=""
# AZURE_CLIENT_SECRET=""
# AZURE_TENANT_ID=""

# Local seed login for jbaddley (npm run db:seed:caswj and Playwright e2e).
SEED_SUPERADMIN_PASSWORD=""
# Named workbook seed is local-only. Staging uses npm run db:seed:caswj:anon.
# SEED_ALLOW_REAL_NAMES="1"
# SEED_ANON="1"

# Portal install (subdomain). Leave unset for the VolunTime product.
# PUBLIC_SIGNUP="true"
# DEFAULT_ORGANIZATION_ID=""
# PORTAL_NAME="VolunTime"

# Playwright target. Unset or "local" runs the seed suite against localhost.
# PROD skips the seed and crawls https://voluntime.app/ (npm run test:e2e:prod).
# E2E_ENV="PROD"
# E2E_BASE_URL="https://voluntime.app/"
